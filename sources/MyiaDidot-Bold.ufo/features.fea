lookup rligStandardLigatureswithZWJ {
  lookupflag 0;
    sub \A \uni200D \e  by \AE;
    sub \A \uni200D \E  by \AE;
    sub \a \uni200D \e  by \ae;
    sub \O \uni200D \e  by \OE;
    sub \O \uni200D \E  by \OE;
    sub \o \uni200D \e  by \oe;
    sub \f \uni200D \f  by \ff;
    sub \f \uni200D \i  by \fi;
    sub \f \uni200D \l  by \fl;
    sub \f \uni200D \f \uni200D \i  by \ffi;
    sub \ff \uni200D \i  by \ffi;
    sub \f \uni200D \f \uni200D \l  by \ffl;
    sub \ff \uni200D \l  by \ffl;
    sub \f \uni200D \f \uni200D \j  by \f_f_j;
    sub \ff \uni200D \j  by \f_f_j;
    sub \f \uni200D \j  by \f_j;
} rligStandardLigatureswithZWJ;

# hist: the long s of 18th-century printing, on request only. s is ſ
# where a lowercase letter follows (the start and middle of a word), round
# at its end, before punctuation, and before f (ſf reads as ff); the
# ligatures ſt ſi ſſ ... then form in liga. After the small caps (smcp
# sets s.sc). The letters: Latin-1 and Latin Extended-A, those of the
# languages that printed the long s. German needs its long s by morpheme
# (Haus|tür), which no such rule knows: type ſ there.
@histLower = [\a \b \c \d \e \f \g \h \i \j \k \l \m \n \o \p \q \r \s \t \u \v \w \x \y \z
    \mu \germandbls \agrave \aacute \acircumflex \atilde \adieresis \aring \ae \ccedilla
    \egrave \eacute \ecircumflex \edieresis \igrave \iacute \icircumflex \idieresis \eth
    \ntilde \ograve \oacute \ocircumflex \otilde \odieresis \oslash \ugrave \uacute
    \ucircumflex \udieresis \yacute \thorn \ydieresis \amacron \abreve \aogonek \cacute
    \ccircumflex \cdotaccent \ccaron \dcaron \dcroat \emacron \ebreve \edotaccent \eogonek
    \ecaron \gcircumflex \gbreve \gdotaccent \gcommaaccent \hcircumflex \hbar \itilde
    \imacron \ibreve \iogonek \dotlessi \ij \jcircumflex \kcommaaccent \kgreenlandic \lacute
    \lcommaaccent \lcaron \ldot \lslash \nacute \ncommaaccent \ncaron \napostrophe \eng
    \omacron \obreve \ohungarumlaut \oe \racute \rcommaaccent \rcaron \sacute \scircumflex
    \scedilla \scaron \tcommaaccent \tcaron \tbar \utilde \umacron \ubreve \uring
    \uhungarumlaut \uogonek \wcircumflex \ycircumflex \zacute \zdotaccent \zcaron \longs];

lookup histLongS {
  lookupflag IgnoreMarks;
    ignore sub \s' \f;
    sub \s' @histLower by \longs;
} histLongS;

feature hist {
    lookup histLongS;
} hist;

lookup ligaStandardLigaturesforLatin {
  lookupflag 0;
    sub \f \f  by \ff;
    sub \f \l  by \fl;
    sub \f \f \l  by \ffl;
    sub \ff \l  by \ffl;
    sub \f \f \b  by \f_f_b;
    sub \ff \b  by \f_f_b;
    sub \f \f \h  by \f_f_h;
    sub \ff \h  by \f_f_h;
    sub \f \f \k  by \f_f_k;
    sub \ff \k  by \f_f_k;
    sub \f \f \t  by \f_f_t;
    sub \ff \t  by \f_f_t;
    sub \f \b  by \f_b;
    sub \f \h  by \f_h;
    sub \f \k  by \f_k;
    sub \f \t  by \f_t;
} ligaStandardLigaturesforLatin;

# long s (typed only in historical text): its ligatures in every language
lookup ligaLongS {
  lookupflag 0;
    sub \longs \longs \l  by \longs_longs_l;
    sub \longs \longs  by \longs_longs;
    sub \longs \b  by \longs_b;
    sub \longs \h  by \longs_h;
    sub \longs \k  by \longs_k;
    sub \longs \l  by \longs_l;
    sub \longs \t  by \longs_t;
} ligaLongS;

lookup ligaLongSexceptTurkish {
  lookupflag 0;
    sub \longs \longs \i  by \longs_longs_i;
    sub \longs_longs \i  by \longs_longs_i;
    sub \longs \i  by \longs_i;
} ligaLongSexceptTurkish;

lookup ligaStandardLigaturesforLatinexceptTurkish {
  lookupflag 0;
    sub \f \i  by \fi;
    sub \f \f \i  by \ffi;
    sub \ff \i  by \ffi;
    sub \f \f \j  by \f_f_j;
    sub \ff \j  by \f_f_j;
    sub \f \j  by \f_j;
} ligaStandardLigaturesforLatinexceptTurkish;

