# Myia Didot OpenType features (GSUB + Greek capital accent spacing).
# kern pairs, mark, mkmk and GDEF are generated by ufo2ft from
# kerning.plist, anchors and public.openTypeCategories.

languagesystem DFLT dflt;
languagesystem cyrl dflt;
languagesystem cyrl BGR ;
languagesystem cyrl MKD ;
languagesystem cyrl SRB ;
languagesystem grek dflt;
languagesystem latn AZE ;
languagesystem latn CAT ;
languagesystem latn CRT ;
languagesystem latn GAG ;
languagesystem latn KAZ ;
languagesystem latn TAT ;
languagesystem latn DEU ;
languagesystem latn dflt;
languagesystem latn MOL ;
languagesystem latn NLD ;
languagesystem latn ROM ;
languagesystem latn TRK ;


# GSUB 


# BEGIN NFD composition (generated by scripts/nfd_compose.py; do not edit)
lookup ccmpComposeAsDrawn {
  lookupflag 0;
    sub A dotbelowcomb brevecmb by uni1EB6;
    sub A dotbelowcomb circumflexcmb by uni1EAC;
    sub Alpha acutecomb by Alphatonos;
    sub Alpha brevecmb by uni1FB8;
    sub Alpha gravecomb by uni1FBA;
    sub Alpha macroncmb by uni1FB9;
    sub Alpha uni0313 acutecomb uni0345 by uni1F8C;
    sub Alpha uni0313 gravecomb by uni1F0A;
    sub Alpha uni0313 gravecomb uni0345 by uni1F8A;
    sub Alpha uni0313 uni0342 uni0345 by uni1F8E;
    sub Alpha uni0313 uni0345 by uni1F88;
    sub Alpha uni0314 acutecomb uni0345 by uni1F8D;
    sub Alpha uni0314 gravecomb by uni1F0B;
    sub Alpha uni0314 gravecomb uni0345 by uni1F8B;
    sub Alpha uni0314 uni0342 uni0345 by uni1F8F;
    sub Alpha uni0314 uni0345 by uni1F89;
    sub Alpha uni0345 by uni1FBC;
    sub E dotbelowcomb circumflexcmb by uni1EC6;
    sub Epsilon uni0313 gravecomb by uni1F1A;
    sub Epsilon uni0314 gravecomb by uni1F1B;
    sub Eta uni0313 acutecomb uni0345 by uni1F9C;
    sub Eta uni0313 gravecomb by uni1F2A;
    sub Eta uni0313 gravecomb uni0345 by uni1F9A;
    sub Eta uni0313 uni0342 uni0345 by uni1F9E;
    sub Eta uni0313 uni0345 by uni1F98;
    sub Eta uni0314 acutecomb uni0345 by uni1F9D;
    sub Eta uni0314 gravecomb by uni1F2B;
    sub Eta uni0314 gravecomb uni0345 by uni1F9B;
    sub Eta uni0314 uni0342 uni0345 by uni1F9F;
    sub Eta uni0314 uni0345 by uni1F99;
    sub Eta uni0345 by uni1FCC;
    sub I uni0308 acutecomb by uni1E2E;
    sub Iota brevecmb by uni1FD8;
    sub Iota macroncmb by uni1FD9;
    sub Iota uni0308 by Iotadieresis;
    sub Iota uni0313 gravecomb by uni1F3A;
    sub Iota uni0314 gravecomb by uni1F3B;
    sub O dotbelowcomb circumflexcmb by uni1ED8;
    sub Omegagreek acutecomb by Omegatonos;
    sub Omegagreek uni0313 by uni1F68;
    sub Omegagreek uni0313 acutecomb by uni1F6C;
    sub Omegagreek uni0313 acutecomb uni0345 by uni1FAC;
    sub Omegagreek uni0313 gravecomb by uni1F6A;
    sub Omegagreek uni0313 gravecomb uni0345 by uni1FAA;
