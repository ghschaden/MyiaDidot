	\fivesuperior \sixsuperior \sevensuperior \eightsuperior 
	\ninesuperior ];
    sub @cc21_back_1 @cc21_match_2'  by [\zero.dnom \one.dnom \two.dnom \three.dnom \four.dnom \five.dnom \six.dnom \seven.dnom \eight.dnom \nine.dnom ] ;
} fracDiagonalFractionsContextual;


