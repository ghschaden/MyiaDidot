feature smcp {
    lookup SmallCapsLower;
    lookup SmallCapsLowerIota;
    lookup SmallCapsGreekAccents1;
    lookup SmallCapsGreekAccents2;
    lookup SmallCapsGreekIota;
    lookup SmallCapMarkForms;
    script latn;
    language TRK;
    lookup SmallCapsTurkish;
    language AZE;
    lookup SmallCapsTurkish;
    language CRT;
    lookup SmallCapsTurkish;
    language GAG;
    lookup SmallCapsTurkish;
    language KAZ;
    lookup SmallCapsTurkish;
    language TAT;
    lookup SmallCapsTurkish;
} smcp;

feature c2sc {
    lookup SmallCapsUpper;
    lookup SmallCapsUpperIota;
    lookup SmallCapsGreekAccents1;
    lookup SmallCapsGreekAccents2;
    lookup SmallCapsGreekIota;
    lookup SmallCapMarkForms;
} c2sc;

feature ss02 {
    featureNames { name "Small caps: SS for ß and ẞ"; };
    lookup SmallCapSharpSAsSS;
} ss02;

# END small caps

# Serbian and Macedonian (SRB, MKD): б with its ascender leaning back;
# in the italic г д п т ѓ too (the upright's are the plain letters).
# After smcp: a small cap is the same in every language.
lookup loclSerbianForms {
  lookupflag 0;
    sub \uni0431 by \uni0431.loclSRB;
    sub \uni0433 by \uni0433.loclSRB;
    sub \uni0434 by \uni0434.loclSRB;
    sub \uni043F by \uni043F.loclSRB;
    sub \uni0442 by \uni0442.loclSRB;
    sub \uni0453 by \uni0453.loclSRB;
} loclSerbianForms;

# Bulgarian (BGR): the lowercase that follows handwriting (в with a closed
# bowl above, г ƨ, д ɡ, и u, к k, л ʌ, п n, т m, ш ɯ, ц щ with a tail,
# ж ъ ь ю with ascenders), й ѝ as и with their mark.
# After smcp, as the Serbian.
lookup loclBulgarianAccented {
  lookupflag 0;
    sub \uni0439 by \uni0438.loclBGR \brevecmb.cyrl;
    sub \uni045D by \uni0438.loclBGR \gravecomb;
} loclBulgarianAccented;

lookup loclBulgarianForms {
  lookupflag 0;
    sub \uni0432 by \uni0432.loclBGR;
    sub \uni0433 by \uni0433.loclBGR;
    sub \uni0434 by \uni0434.loclBGR;
    sub \uni0436 by \uni0436.loclBGR;
    sub \uni0438 by \uni0438.loclBGR;
    sub \uni043A by \uni043A.loclBGR;
    sub \uni043B by \uni043B.loclBGR;
    sub \uni043F by \uni043F.loclBGR;
    sub \uni0442 by \uni0442.loclBGR;
    sub \uni0446 by \uni0446.loclBGR;
    sub \uni0448 by \uni0448.loclBGR;
    sub \uni0449 by \uni0449.loclBGR;
    sub \uni044A by \uni044A.loclBGR;
    sub \uni044C by \uni044C.loclBGR;
    sub \uni044E by \uni044E.loclBGR;
} loclBulgarianForms;


lookup ss11GreekContextualForms {
  lookupflag 0;
    sub \theta by \thetasymbolgreek ;
} ss11GreekContextualForms;

lookup saltStylisticAlternatives {
  lookupflag 0;
    sub \Scedilla by \Scommaaccent ;
    sub \scedilla by \scommaaccent ;
    sub \Tcommaaccent by \uni021A ;
    sub \tcommaaccent by \uni021B ;
