    sub omega uni0313 gravecomb by uni1F62;
    sub omega uni0313 gravecomb uni0345 by uni1FA2;
    sub omega uni0313 uni0342 by uni1F66;
    sub omega uni0313 uni0342 uni0345 by uni1FA6;
