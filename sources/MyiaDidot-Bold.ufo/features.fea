    sub Upsilon uni0314 by uni1F59;
    sub Upsilon uni0314 acutecomb by uni1F5D;
    sub Upsilon uni0314 gravecomb by uni1F5B;
    sub Upsilon uni0314 uni0342 by uni1F5F;
    sub alpha acutecomb uni0345 by uni1FB4;
    sub alpha brevecmb by uni1FB0;
    sub alpha macroncmb by uni1FB1;
    sub dieresis acutecomb by dieresistonos;
