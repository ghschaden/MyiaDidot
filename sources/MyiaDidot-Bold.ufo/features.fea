# Scientific inferiors (sinf): the subscript figures, as subs has them.
feature sinf {
    lookup subsSubscriptForms;
} sinf;

# Ordinals (ordn): a or o after a figure is ª or º (1º, 2ª, 1.º), N o
# before a figure (No 5, No5) is № ("No one" stays) (figures as onum leaves them: the
# figure-form lookups come later).
@ordnFigures = [\zero \one \two \three \four \five \six \seven \eight \nine
    \zerooldstyle \oneoldstyle \twooldstyle \threeoldstyle \fouroldstyle
    \fiveoldstyle \sixoldstyle \sevenoldstyle \eightoldstyle \nineoldstyle];

lookup ordnOrdinals {
    sub @ordnFigures [\a \A]' by \ordfeminine;
    sub @ordnFigures [\o \O]' by \ordmasculine;
    sub @ordnFigures \period [\a \A]' by \ordfeminine;
    sub @ordnFigures \period [\o \O]' by \ordmasculine;
    sub \N' \o' @ordnFigures by \uni2116;
    sub \N' \o' \space @ordnFigures by \uni2116;
} ordnOrdinals;

feature ordn {
    lookup ordnOrdinals;
} ordn;

# aalt: every single alternate the other features give (feaLib collects
# them), so a glyph panel offers them all; nothing listed by hand
feature aalt {
    feature locl;
    feature smcp;
    feature c2sc;
    feature case;
    feature onum;
    feature lnum;
    feature pnum;
    feature tnum;
    feature zero;
    feature sups;
    feature subs;
    feature sinf;
    feature numr;
    feature dnom;
    feature ordn;
    feature salt;
    feature ss01;
    feature ss02;
    feature ss11;
    feature hist;
} aalt;

# GPOS

lookup GreekCapsafterTonos {
  lookupflag 0;
    pos \Alpha <21 0 21 0>;
    pos \Epsilon <449 0 449 0>;
    pos \Eta <449 0 449 0>;
    pos \Iota <449 0 449 0>;
    pos \Omicron <333 0 333 0>;
    pos \Upsilon <449 0 449 0>;
    pos \Omegagreek <358 0 358 0>;
} GreekCapsafterTonos;

lookup GreekCapsafterVaria {
  lookupflag 0;
    pos \Epsilon <385 0 385 0>;
    pos \Eta <385 0 385 0>;
    pos \Iota <385 0 385 0>;
    pos \Omicron <268 0 268 0>;
    pos \Upsilon <385 0 385 0>;
    pos \Omegagreek <293 0 293 0>;
} GreekCapsafterVaria;

lookup GreekCapsafterBreathings {
  lookupflag 0;
    pos \Alpha <92 0 92 0>;
    pos \Epsilon <520 0 520 0>;
    pos \Eta <520 0 520 0>;
    pos \Iota <520 0 520 0>;
    pos \Omicron <404 0 404 0>;
    pos \Rho <520 0 520 0>;
    pos \Upsilon <520 0 520 0>;
    pos \Omegagreek <428 0 428 0>;
} GreekCapsafterBreathings;

lookup GreekCapsafteraBreathingandOxia {
  lookupflag 0;
    pos \Alpha <285 0 285 0>;
    pos \Epsilon <713 0 713 0>;
    pos \Eta <713 0 713 0>;
    pos \Iota <713 0 713 0>;
    pos \Omicron <597 0 597 0>;
    pos \Upsilon <713 0 713 0>;
    pos \Omegagreek <622 0 622 0>;
} GreekCapsafteraBreathingandOxia;

lookup GreekCapsafteraBreathingandVaria {
  lookupflag 0;
    pos \Alpha <141 0 141 0>;
    pos \Epsilon <570 0 570 0>;
    pos \Eta <570 0 570 0>;
    pos \Iota <570 0 570 0>;
    pos \Omicron <453 0 453 0>;
    pos \Upsilon <570 0 570 0>;
    pos \Omegagreek <478 0 478 0>;
} GreekCapsafteraBreathingandVaria;

lookup GreekCapsafteraBreathingandPerispomeni {
  lookupflag 0;
    pos \Alpha <175 0 175 0>;
    pos \Epsilon <603 0 603 0>;
    pos \Eta <603 0 603 0>;
    pos \Iota <603 0 603 0>;
    pos \Omicron <487 0 487 0>;
    pos \Upsilon <603 0 603 0>;
    pos \Omegagreek <512 0 512 0>;
} GreekCapsafteraBreathingandPerispomeni;

lookup GreekCapsAccentPositioning {
  lookupflag 0;
    @cc33_match_1 = [\Alpha \Epsilon \Eta \Iota \Omicron \Rho \Upsilon \Omegagreek ];
    @cc33_match_2 = [\acutecomb.grek ];
    @cc33_match_3 = [\gravecomb.grek ];
    @cc33_match_4 = [\uni0313.grek \uni0314.grek ];
    @cc33_match_5 = [\uni0313_acutecomb.grek \uni0314_acutecomb.grek ];
    @cc33_match_6 = [\uni0313_gravecomb.grek \uni0314_gravecomb.grek ];
    @cc33_match_7 = [\uni0313_uni0342 \uni0314_uni0342 ];
    pos @cc33_match_1'lookup GreekCapsafterTonos  @cc33_match_2' ;
    pos @cc33_match_1'lookup GreekCapsafterVaria  @cc33_match_3' ;
    pos @cc33_match_1'lookup GreekCapsafterBreathings  @cc33_match_4' ;
    pos @cc33_match_1'lookup GreekCapsafteraBreathingandOxia  @cc33_match_5' ;
    pos @cc33_match_1'lookup GreekCapsafteraBreathingandVaria  @cc33_match_6' ;
    pos @cc33_match_1'lookup GreekCapsafteraBreathingandPerispomeni  @cc33_match_7' ;
} GreekCapsAccentPositioning;

feature kern {
    # Upstream Theano used a FontForge 'required' feature for this;
    # it shifts Greek capitals right of a preceding spacing accent
    # and must run before the generated kerning.
    lookup GreekCapsAccentPositioning;
    # Automatic Code
} kern;

# BEGIN figure forms (generated by scripts/space_figures.py; do not edit)
lookup lnumLiningFigures {
    sub \zerooldstyle by \zero;
    sub \oneoldstyle by \one;
    sub \twooldstyle by \two;
    sub \threeoldstyle by \three;
    sub \fouroldstyle by \four;
    sub \fiveoldstyle by \five;
    sub \sixoldstyle by \six;
    sub \sevenoldstyle by \seven;
    sub \eightoldstyle by \eight;
    sub \nineoldstyle by \nine;
    sub \zerooldstyle.tf by \zero;
    sub \oneoldstyle.tf by \one;
    sub \twooldstyle.tf by \two;
    sub \threeoldstyle.tf by \three;
    sub \fouroldstyle.tf by \four;
    sub \fiveoldstyle.tf by \five;
    sub \sixoldstyle.tf by \six;
    sub \sevenoldstyle.tf by \seven;
    sub \eightoldstyle.tf by \eight;
    sub \nineoldstyle.tf by \nine;
} lnumLiningFigures;

lookup pnumProportionalFigures {
    sub \zero by \zero.pf;
    sub \one by \one.pf;
    sub \two by \two.pf;
    sub \three by \three.pf;
    sub \four by \four.pf;
    sub \five by \five.pf;
    sub \six by \six.pf;
    sub \seven by \seven.pf;
    sub \eight by \eight.pf;
    sub \nine by \nine.pf;
} pnumProportionalFigures;

lookup tnumOldstyleFigures {
    sub \zerooldstyle by \zerooldstyle.tf;
    sub \oneoldstyle by \oneoldstyle.tf;
    sub \twooldstyle by \twooldstyle.tf;
    sub \threeoldstyle by \threeoldstyle.tf;
    sub \fouroldstyle by \fouroldstyle.tf;
    sub \fiveoldstyle by \fiveoldstyle.tf;
    sub \sixoldstyle by \sixoldstyle.tf;
    sub \sevenoldstyle by \sevenoldstyle.tf;
    sub \eightoldstyle by \eightoldstyle.tf;
    sub \nineoldstyle by \nineoldstyle.tf;
    sub \zero.pf by \zero;
    sub \one.pf by \one;
    sub \two.pf by \two;
    sub \three.pf by \three;
    sub \four.pf by \four;
    sub \five.pf by \five;
    sub \six.pf by \six;
    sub \seven.pf by \seven;
    sub \eight.pf by \eight;
    sub \nine.pf by \nine;
} tnumOldstyleFigures;

lookup zeroSlashedZero {
    sub \zero by \zero.zero;
    sub \zero.pf by \zero.zero.pf;
    sub \zerooldstyle by \zerooldstyle.zero;
    sub \zerooldstyle.tf by \zerooldstyle.zero.tf;
} zeroSlashedZero;

feature lnum {
    lookup lnumLiningFigures;
} lnum;

feature pnum {
    lookup pnumProportionalFigures;
} pnum;

feature tnum {
    lookup tnumOldstyleFigures;
} tnum;

feature zero {
    lookup zeroSlashedZero;
} zero;
# END figure forms

