    sub Omegagreek uni0314 by uni1F69;
    sub Omegagreek uni0314 acutecomb by uni1F6D;
    sub Omegagreek uni0314 acutecomb uni0345 by uni1FAD;
    sub Omegagreek uni0314 gravecomb by uni1F6B;
    sub Omegagreek uni0314 gravecomb uni0345 by uni1FAB;
    sub Omegagreek uni0314 uni0342 by uni1F6F;
    sub Omegagreek uni0314 uni0342 uni0345 by uni1FAF;
    sub Omegagreek uni0314 uni0345 by uni1FA9;
    sub Omegagreek uni0345 by uni1FFC;
    sub Omicron acutecomb by Omicrontonos;
    sub Omicron gravecomb by uni1FF8;
    sub Omicron uni0313 by uni1F48;
    sub Omicron uni0313 acutecomb by uni1F4C;
    sub Omicron uni0313 gravecomb by uni1F4A;
    sub Omicron uni0314 by uni1F49;
    sub Omicron uni0314 acutecomb by uni1F4D;
    sub Omicron uni0314 gravecomb by uni1F4B;
    sub U uni0308 acutecomb by uni01D7;
    sub Upsilon acutecomb by Upsilontonos;
    sub Upsilon brevecmb by uni1FE8;
    sub Upsilon gravecomb by uni1FEA;
