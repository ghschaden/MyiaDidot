# GPOS 


lookup EnclosedCyrillicLetters {
  lookupflag 0;
    pos \afii10065 <288 0 592 0>;
    pos \afii10067 <332 0 702 0>;
    pos \afii10068 <344 0 708 0>;
    pos \afii10069 <306 0 633 0>;
    pos \afii10070 <336 0 718 0>;
    pos \afii10073 <352 0 714 0>;
    pos \afii10074 <268 0 556 0>;
    pos \afii10101 <326 0 706 0>;
    pos \afii10102 <336 0 708 0>;
    pos \afii10195 <314 0 668 0>;
    pos \uniA641 <312 0 674 0>;
    pos \afii10192 <310 0 648 0>;
    pos \afii10065.csl <292 0 608 0>;
} EnclosedCyrillicLetters;

lookup RQDEnclosedCyrillicLetters {
  lookupflag 0;
    @cc44_match_1 = [\afii10065 \afii10067 \afii10068 \afii10070 \afii10073 \afii10074 \afii10101 
	\afii10102 \afii10195 \uniA641 \afii10065.csl \afii10192 ];
    @cc44_match_2 = [\uni0488 \uni0489 \uni20DD \uniA670 \uniA671 \uniA672 ];
    @cc44_match_3 = [\uni0483 ];
    pos @cc44_match_1'lookup EnclosedCyrillicLetters  @cc44_match_2' ;
    pos @cc44_match_1'lookup EnclosedCyrillicLetters  @cc44_match_3' @cc44_match_2' ;
} RQDEnclosedCyrillicLetters;

lookup GreekCapsafterOxia {
  lookupflag 0;
    pos \Epsilon <220 0 220 0>;
