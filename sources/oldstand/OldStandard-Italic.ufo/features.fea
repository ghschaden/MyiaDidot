} rligStandardLigatureswithZWJ;

lookup ligaStandardLigaturesforNederlands {
  lookupflag 0;
    sub \I \J  by \IJ;
    sub \i \j  by \ij;
} ligaStandardLigaturesforNederlands;

lookup ligaStandardLigaturesforLatin {
  lookupflag 0;
    sub \f \f  by \ff;
    sub \f \l  by \fl;
    sub \ff \l  by \ffl;
    sub \f \f \l  by \ffl;
    sub \ff \j  by \f_f_j;
    sub \f \f \j  by \f_f_j;
    sub \f \j  by \f_j;
} ligaStandardLigaturesforLatin;

lookup ligaStandardLigaturesforLatinexceptTurkish {
  lookupflag 0;
    sub \f \i  by \fi;
    sub \ff \i  by \ffi;
    sub \f \f \i  by \ffi;
} ligaStandardLigaturesforLatinexceptTurkish;

lookup dligDiscretionaryLigaturesforGerman {
  lookupflag 0;
    sub \f \f  by \ff;
    sub \f \i  by \fi;
    sub \f \l  by \fl;
    sub \ff \i  by \ffi;
    sub \f \f \i  by \ffi;
    sub \ff \l  by \ffl;
    sub \f \f \l  by \ffl;
    sub \ff \j  by \f_f_j;
    sub \f \f \j  by \f_f_j;
    sub \f \j  by \f_j;
} dligDiscretionaryLigaturesforGerman;

lookup fracDiagonalFractions {
  lookupflag 0;
    sub \slash by \uni2215.frac ;
} fracDiagonalFractions;

lookup fracDiagonalFractionsContextual {
  lookupflag 0;
    @cc25_match_1 = [\uni2215.frac \zero.dnom \one.dnom \two.dnom \three.dnom \four.dnom \five.dnom 
	\six.dnom \seven.dnom \eight.dnom \nine.dnom ];
    @cc25_match_2 = [\zerosuperior \onesuperior \twosuperior \threesuperior \foursuperior 
	\fivesuperior \sixsuperior \sevensuperior \eightsuperior 
	\ninesuperior ];
    @cc25_back_1 = [\uni2215.frac \zero.dnom \one.dnom \two.dnom \three.dnom \four.dnom \five.dnom 
	\six.dnom \seven.dnom \eight.dnom \nine.dnom ];
    @cc25_back_2 = [\zerosuperior \onesuperior \twosuperior \threesuperior \foursuperior 
	\fivesuperior \sixsuperior \sevensuperior \eightsuperior 
	\ninesuperior ];
    sub @cc25_back_1 @cc25_match_2'  by [\zero.dnom \one.dnom \two.dnom \three.dnom \four.dnom \five.dnom \six.dnom \seven.dnom \eight.dnom \nine.dnom ] ;
} fracDiagonalFractionsContextual;

