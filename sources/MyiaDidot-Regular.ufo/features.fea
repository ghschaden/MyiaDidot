lookup loclss01RomanianVariantForms {
  lookupflag 0;
    sub \Scedilla by \Scommaaccent ;
    sub \scedilla by \scommaaccent ;
    sub \Tcommaaccent by \uni021A ;
    sub \tcommaaccent by \uni021B ;
} loclss01RomanianVariantForms;

# BEGIN small caps (generated by scripts/smallcaps.py; do not edit)

