feature ccmp {

 script cyrl;
     language dflt ;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;

 script grek;
     language dflt ;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;

 script latn;
     language dflt ;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
     language AZE  exclude_dflt;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
     language CRT  exclude_dflt;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
     language DEU  exclude_dflt;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
     language MOL  exclude_dflt;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
     language ROM  exclude_dflt;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
     language TRK  exclude_dflt;
      lookup ccmpSimpleGlyphComposition;
      lookup ccmpDotlessVariants;
      lookup ccmpCyrillicAccents;
      lookup ccmpCapitalAccents;
      lookup ccmpStackedCapitalAccents;
      lookup ccmpSubsitutionforGreekAccents;
} ccmp;

