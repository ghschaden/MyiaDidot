    sub \f \uni200D \l  by \fl;
    sub \f \uni200D \f \uni200D \i  by \ffi;
    sub \ff \uni200D \i  by \ffi;
    sub \f \uni200D \f \uni200D \l  by \ffl;
    sub \ff \uni200D \l  by \ffl;
    sub \f \uni200D \f \uni200D \j  by \f_f_j;
