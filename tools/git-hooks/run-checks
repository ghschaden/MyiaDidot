#!/bin/sh
# The pre-commit checks themselves, started detached by the pre-commit hook:
#   run-checks STATE KEY REPRODUCE
# so that a commit killed by a timeout leaves them running to the end. The
# result lands in STATE/KEY.pass or STATE/KEY.fail (output in STATE/KEY.log),
# where the next commit of the same tree finds it instead of running again.

state=$1 key=$2 repro=$3
if [ "${4:-}" != --inside ]; then
    echo $$ > "$state/$key.pid"
    # one validation at a time on this machine, whichever working copy
    # (worktree) it is for: each uses up to 4 cores (pytest -n 4, MYIA_JOBS)
    lock="$(cd "$(git rev-parse --git-common-dir)" && pwd)/myia-validate.lock"
    root=$(pwd)
    if flock "$lock" .venv/bin/python -I scripts/validate_snapshot.py --tree "$4" --head "$5" -- \
        sh tools/git-hooks/run-checks "$state" "$key" "$repro" --inside "$root" >> "$state/$key.log" 2>&1; then
        touch "$state/$key.pass"
    else
        touch "$state/$key.fail"
    fi
    rm -f "$state/$key.pid"
    exit 0
fi

checks() {
    echo "pre-commit: running the test suite..."
    if ! .venv/bin/pytest -q -x -n "${MYIA_JOBS:-4}" -p no:cacheprovider; then
        echo
        echo "pre-commit: tests failed; commit aborted."
        echo "  Fix the cause, or if the change is intended, update the baselines:"
        echo "  .venv/bin/python scripts/update_test_data.py --help"
        return 1
    fi

    # the generated styles as their generators make them, when a commit
    # touches them, the Regular they come from, or a generator (≈40 s;
    # needs FontForge)
    [ "$repro" = 1 ] || return 0
    # only the styles a plain make generate did not just make from these
    # very inputs (scripts/stale.py unproven; FULL_REPRODUCE=1: all)
    styles="Italic Bold BoldItalic"
    if [ -n "${5:-}" ]; then
        styles=$(.venv/bin/python -I scripts/stale.py unproven "$5/build/stale/stamp.json") || styles="Italic Bold BoldItalic"
    fi
    if [ -z "$styles" ]; then
        echo "pre-commit: make reproduce skipped: the styles are what the last make generate made"
        return 0
    fi
    if command -v fontforge >/dev/null 2>&1; then
        echo "pre-commit: checking the generated styles (make reproduce: $styles)..."
        # shellcheck disable=SC2086
        if ! .venv/bin/python -I scripts/check_reproducible.py $styles; then
            echo
            echo "pre-commit: a generator run would change the generated styles; commit aborted."
            echo "  Move the edit into the Regular or the generator (CLAUDE.md), or rerun them."
            return 1
        fi
    else
        echo "pre-commit: fontforge missing; required reproduction cannot run"
        return 1
    fi
}

checks
